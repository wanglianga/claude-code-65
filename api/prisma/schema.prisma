generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- 用户与角色 ----------------
enum Role {
  ADMIN            // 平台管理员
  RESIDENT         // 居民
  STAFF            // 社区工作人员
  LAWYER           // 值班律师
  JUDICIAL         // 司法所工作人员
  VOLUNTEER        // 志愿者
  WOMEN_FEDERATION // 妇联（家暴协同单位）
  POLICE           // 派出所（家暴协同单位）
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  password     String
  name         String
  role         Role
  phone        String?
  organization String? // 所属社区 / 律所 / 司法所 / 志愿队
  street       String? // 所属街道
  onLeave      Boolean  @default(false) // 律师临时请假
  leaveReason  String?
  createdAt    DateTime @default(now())

  residentCases  Case[]                    @relation("ResidentCases")
  lawyerCases    Case[]                    @relation("LawyerCases")
  reviewedCases  Case[]                    @relation("ReviewedCases")
  materials      Material[]
  tasks          Task[]                    @relation("TaskAssignee")
  createdTasks   Task[]                    @relation("TaskCreator")
  completedTasks Task[]                    @relation("TaskCompletedBy")
  participants   ServiceOrderParticipant[]
  appointments   Appointment[]             @relation("LawyerAppointments")
  conflictChecks ConflictCheck[]
  events         CaseEvent[]
  referrals      Referral[]
  deadlineReminders DeadlineReminder[]
  acceptedReferrals Referral[]       @relation("ReferralAcceptedBy")
  referralGrants ReferralAuthorization[]
}

// ---------------- 案件 ----------------
enum CaseType {
  LABOR_DISPUTE          // 劳动纠纷
  MARRIAGE_FAMILY        // 婚姻家事
  HOUSING_RENTAL         // 房屋租赁
  NEIGHBORHOOD_TORT      // 邻里侵权
  CONSUMER_RIGHTS        // 消费维权
  ADMIN_RECONSIDERATION  // 行政复议
}

enum CaseSource {
  ONLINE         // 居民线上提交
  COMMUNITY_EVENT// 社区活动现场咨询
  HOTLINE        // 热线转入
  OFFLINE_PAPER  // 线下纸质材料补录
  CROSS_STREET   // 跨街道转入
}

enum Urgency {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum Confidentiality {
  NORMAL       // 普通
  CONFIDENTIAL // 保密（涉未成年人等）
  STRICT       // 严格保密（家暴等）
}

enum CaseStatus {
  SUBMITTED           // 已提交，待初审
  UNDER_REVIEW        // 资格初审中
  CLASSIFIED          // 已分流
  AWAITING_LAWYER     // 待律师接案
  IN_SERVICE          // 服务进行中
  MATERIAL_SUPPLEMENT // 待补正材料
  REFERRED            // 已转介
  CLOSED              // 已结案归档
}

enum Category {
  LEGAL_AID         // 法律援助
  PEOPLES_MEDIATION // 人民调解
  JUDICIAL_REFERRAL // 司法所转介
  HOTLINE_ANSWER    // 热线解答
  COMMERCIAL_LAWYER // 商业律师服务
}

model Case {
  id          String   @id @default(cuid())
  caseNo      String   @unique
  title       String
  type        CaseType
  description String   // 诉求与案件事实
  source      CaseSource @default(ONLINE)
  status      CaseStatus @default(SUBMITTED)
  urgency     Urgency  @default(NORMAL)
  priority    Priority @default(NORMAL)
  confidentiality Confidentiality @default(NORMAL)
  category    Category? // 分流去向（初审结果）

  // 申请人信息（居民线上提交时与 resident 一致；线下补录时由工作人员代填）
  applicantName  String
  applicantPhone String?
  residentId     String?
  resident       User?   @relation("ResidentCases", fields: [residentId], references: [id])

  // 资格与特殊情形
  familyIncome   Int?    // 家庭月收入（元）
  isDisabled     Boolean @default(false) // 是否残障
  involvesMinor  Boolean @default(false) // 是否涉未成年人
  isWageArrearsGroup Boolean @default(false) // 欠薪群体
  isDomesticViolence Boolean @default(false) // 家庭暴力风险
  isElderlySupport   Boolean @default(false) // 老人赡养
  isMinorRights      Boolean @default(false) // 未成年人权益
  opponentSued       Boolean @default(false) // 对方已经起诉
  opposingParties    String? // 冲突主体（对方当事人）
  statuteOfLimitations DateTime? // 诉讼时效届满日
  deadlineNotes        String?  // 其他关键期限说明
  incidentDate         DateTime? // 事件发生日期（欠薪开始日、租约到期日等）
  estimatedDeadline    DateTime? // 推算得出的关键期限（无明确时效日期时按案件类型法定时效推算）
  deadlineRisk         String?   // 期限风险等级：LOW / MEDIUM / HIGH / EXPIRED
  deadlineRiskReason   String?   // 期限风险评估说明
  residentIntent       String?   // 居民是否愿意立即启动程序：WILLING / NOT_YET / DECLINED
  residentIntentNote   String?
  street               String?  // 所属街道
  applicantAddress     String?  // 申请人现住址/详细地址（家暴案件按授权范围保密）

  // 家暴风险信号：婚姻咨询中出现威胁、伤害或控制财产等描述时由平台自动识别
  dvSignalThreat       Boolean  @default(false) // 存在威胁/恐吓描述
  dvSignalHarm         Boolean  @default(false) // 存在伤害/暴力描述
  dvSignalControl      Boolean  @default(false) // 存在控制财产/经济控制描述
  dvSignalNote         String?  // 命中的风险描述原文摘录
  dvHandled            Boolean  @default(false) // 社区工作人员是否已完成家暴安全处置（安全信息记录+协同转介）

  // 初审
  reviewedById   String?
  reviewedBy     User?   @relation("ReviewedCases", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  reviewNotes    String?
  incomeQualified Boolean? // 经济困难资格初审是否通过

  // 承办律师
  lawyerId       String?
  lawyer         User?   @relation("LawyerCases", fields: [lawyerId], references: [id])

  ruleNotes      String? // 特殊规则命中说明
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  closedAt       DateTime?

  materials      Material[]
  keyDates       KeyDate[]
  tasks          Task[]
  appointments   Appointment[]
  referrals      Referral[]
  conflictChecks ConflictCheck[]
  events         CaseEvent[]
  archive        Archive?
  serviceOrder   ServiceOrder?
  reminders      DeadlineReminder[]
  safetyPlan     SafetyPlan?
}

// 证据材料
enum MaterialStatus {
  MISSING          // 待补（工作人员/律师登记的要求补交项）
  RECEIVED         // 已提交待核验
  NEEDS_CORRECTION // 需补正
  VERIFIED         // 已核验
}

model Material {
  id         String @id @default(cuid())
  caseId     String
  case       Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  name       String
  kind       String? // 证据类型：合同/票据/照片/聊天记录/鉴定等
  status     MaterialStatus @default(RECEIVED)
  filePath   String? // 上传文件存储路径（线下补录可仅登记无文件）
  note       String?
  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id])
  createdAt  DateTime @default(now())
}

// 关键时间节点
model KeyDate {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  label  String // 如：仲裁时效届满、开庭日、合同到期日
  date   DateTime
  kind   String? // statute / court / other
}

// 服务单（一个案件一张服务单，多角色协同推进）
enum ServiceOrderStatus {
  OPEN
  IN_PROGRESS
  DONE
}

model ServiceOrder {
  id        String @id @default(cuid())
  orderNo   String @unique
  caseId    String @unique
  case      Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  status    ServiceOrderStatus @default(OPEN)
  createdAt DateTime @default(now())
  participants ServiceOrderParticipant[]
}

model ServiceOrderParticipant {
  id             String @id @default(cuid())
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  userId         String
  user           User   @relation(fields: [userId], references: [id])
  duty           String? // 在服务单中的分工说明
  joinedAt       DateTime @default(now())
  @@unique([serviceOrderId, userId])
}

// 协同任务
enum TaskType {
  MATERIAL_SUPPLEMENT // 材料补正
  HOME_VISIT          // 上门协助（老人/残障）
  CONFLICT_CHECK      // 利益冲突核查
  FOLLOW_UP           // 回访
  COORDINATION        // 多单位协同
  REASSIGNMENT        // 重新指派（律师请假等）
  DEADLINE_WATCH      // 关键期限盯办
  OTHER
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

model Task {
  id           String @id @default(cuid())
  caseId       String
  case         Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type         TaskType @default(OTHER)
  title        String
  description  String?
  status       TaskStatus @default(OPEN)
  assigneeId   String? // 指定到人；为空则按 assigneeRole 抢单/办理
  assignee     User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])
  assigneeRole Role?   // 指定到角色（如任意志愿者）
  dueDate      DateTime?
  createdById  String?
  createdBy    User?   @relation("TaskCreator", fields: [createdById], references: [id])
  createdAt    DateTime @default(now())
  completedAt  DateTime?
  completedById String?
  completedBy   User?   @relation("TaskCompletedBy", fields: [completedById], references: [id])
}

// 预约（居民与律师的咨询预约）
enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Appointment {
  id          String @id @default(cuid())
  caseId      String
  case        Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  lawyerId    String?
  lawyer      User?  @relation("LawyerAppointments", fields: [lawyerId], references: [id])
  scheduledAt DateTime
  location    String? // 社区服务中心/线上电话等
  status      AppointmentStatus @default(PENDING)
  note        String?
  createdAt   DateTime @default(now())
}

// 利益冲突核查
model ConflictCheck {
  id          String @id @default(cuid())
  caseId      String
  case        Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  lawyerId    String
  lawyer      User   @relation(fields: [lawyerId], references: [id])
  parties     String // 核查的冲突主体
  hasConflict Boolean
  note        String?
  checkedAt   DateTime @default(now())
}

// 转介（司法所转介 / 跨街道转介 / 家暴协同转介 / 其他单位）
enum ReferralStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
}

model Referral {
  id          String @id @default(cuid())
  caseId      String
  case        Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type        String // JUDICIAL / CROSS_STREET / WOMEN_FEDERATION / POLICE / OTHER_ORG
  fromStreet  String?
  toStreet    String?
  toUnit      String // 接收单位
  reason      String?
  status      ReferralStatus @default(PENDING)
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  handledAt   DateTime?
  acceptedById String? // 实际接收人（协同单位授权人员）
  acceptedBy   User?  @relation("ReferralAcceptedBy", fields: [acceptedById], references: [id])
  isSafetyReferral Boolean @default(false) // 是否家暴风险协同转介（司法所/妇联/派出所联动）
  grants      ReferralAuthorization[]
  followUps   ReferralFollowUp[]
}

// 家暴案件安全处置信息（社区工作人员记录：安全联系人 / 临时住所 / 报警情况）
model SafetyPlan {
  id              String   @id @default(cuid())
  caseId          String   @unique
  case            Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  recordedById    String?
  recordedAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt
  emergencyContactName   String? // 紧急安全联系人
  emergencyContactPhone  String?
  emergencyContactRel    String? // 与申请人关系
  shelterName      String? // 临时安置点/庇护场所名称
  shelterAddress   String? // 临时住所地址（敏感，按授权保密）
  shelterArranged  Boolean @default(false) // 是否已安排临时住所
  policeReported   Boolean @default(false) // 是否已报警
  policeReportNo   String?  // 报警回执/受案编号
  policeReportAt   DateTime? // 最近报警时间
  policeNote       String?  // 报警处置情况
  riskLevel        String?  // HIGH / MEDIUM / LOW
  notes            String?
}

// 转介授权：只有被授权的协同单位人员可查看当事人联系方式和住址
model ReferralAuthorization {
  id          String   @id @default(cuid())
  referralId  String
  referral    Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  scope       String   @default("CONTACT_ADDRESS") // 授权范围：联系方式+住址
  grantedById String?
  grantedAt   DateTime @default(now())
  revokedAt   DateTime?

  @@unique([referralId, userId])
}

// 转介后续回访（协同单位接收后，平台保留转介节点与后续回访时间）
model ReferralFollowUp {
  id          String   @id @default(cuid())
  referralId  String
  referral    Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  scheduledAt DateTime // 计划回访时间
  result      String?  // 回访结果
  doneAt      DateTime? // 实际完成时间
  doneById    String?
  createdAt   DateTime @default(now())

  @@index([scheduledAt])
}

// 期限提醒记录（工作人员提醒居民关键期限，及时性用于服务质量复盘）
model DeadlineReminder {
  id           String @id @default(cuid())
  caseId       String
  case         Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  channel      String // PHONE / VISIT / MESSAGE / OTHER
  note         String?
  timeliness   String // TIMELY（及时）/ LATE（临近才提醒）/ MISSED（逾期才提醒）
  daysLeftAtReminder Int? // 提醒时距关键期限天数
  remindedById String?
  remindedBy   User?  @relation(fields: [remindedById], references: [id])
  createdAt    DateTime @default(now())
}

// 结案档案
model Archive {
  id                 String @id @default(cuid())
  caseId             String @unique
  case               Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  consultationOpinion String? // 咨询意见
  materialCorrections String? // 材料补正记录
  referralDestination String? // 转介去向
  lawyerHours        Float?   // 律师工时（小时）
  followUpResult     String?  // 回访结果
  satisfaction       Int?     // 居民满意度 1-5
  satisfactionNote   String?
  closedById         String?
  closedAt           DateTime @default(now())
}

// 案件时间线（审计/协同可见）
model CaseEvent {
  id        String @id @default(cuid())
  caseId    String
  case      Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?  @relation(fields: [actorId], references: [id])
  action    String
  detail    String?
  createdAt DateTime @default(now())
}
